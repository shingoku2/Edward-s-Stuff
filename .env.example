# Gaming AI Assistant Configuration (Example)

# AI Provider Configuration
# Options: ollama, openai_compatible
AI_PROVIDER=ollama

# Ollama Configuration
# Note: OLLAMA_HOST and OLLAMA_BASE_URL are aliases - use either one
OLLAMA_HOST=http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434  # Alias for OLLAMA_HOST
OLLAMA_MODEL=llama3

# OpenAI-Compatible Configuration (Optional)
# Use these if AI_PROVIDER=openai_compatible
AI_API_KEY=your-api-key-here
AI_BASE_URL=http://localhost:1234/v1
AI_MODEL=local-model

# Application Settings
OVERLAY_HOTKEY=ctrl+shift_g  # Format: ctrl+shift+g, alt+space, etc.
CHECK_INTERVAL=5  # Polling interval in seconds (1-60)

# Overlay Window Settings
OVERLAY_X=100
OVERLAY_Y=100
OVERLAY_WIDTH=900
OVERLAY_HEIGHT=700
OVERLAY_MINIMIZED=false  # Boolean: true/false
OVERLAY_OPACITY=0.95  # Decimal range: 0.0 to 1.0

# Feature Flags
MACROS_ENABLED=false  # Boolean: true/false
MACRO_SAFETY_UNDERSTOOD=false  # Boolean: true/false - must be true to enable macros
MAX_MACRO_REPEAT=10  # Integer range: 1-100
MACRO_EXECUTION_TIMEOUT=300  # Timeout in seconds for macro execution (30-600)

# Master Password (optional)
# Used to protect sensitive settings and credentials
OMNIX_MASTER_PASSWORD=

# HRM (Heuristic Reasoning Model) Settings
HRM_ENABLED=false  # Boolean: true/false
HRM_MAX_INFERENCE_TIME=5.0  # Timeout in seconds for reasoning tasks

# Supabase Licensing
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
OMNIX_LICENSE_KEY=
OMNIX_DEV_MODE=1    # Set to 1 during development to skip licensing