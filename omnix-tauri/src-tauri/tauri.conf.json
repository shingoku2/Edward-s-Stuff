{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Omnix",
  "version": "0.1.0",
  "identifier": "com.omnix.gaming",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "security": { "csp": null },
    "windows": [
      {
        "label": "main",
        "title": "Omnix",
        "width": 900,
        "height": 700,
        "center": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    },
    "longDescription": "Omnix Gaming Companion - AI assistant for gamers.",
    "shortDescription": "AI gaming companion",
    "category": "Utility",
    "copyright": "",
    "licenseFile": null
  }
}
